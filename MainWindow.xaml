<Window x:Class="CyberChatBot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cyber Chat"
        Height="800"
        Width="1280"
        MinHeight="650"
        MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#10121F">

    <!-- ================= STYLES (dark theme) ================= -->
    <Window.Resources>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9BA8C7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,8,0,3"/>
        </Style>

        <Style x:Key="DarkBox" TargetType="TextBox">
            <Setter Property="Background" Value="#252A40"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="#3A4266"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#00D5F2"/>
            <Setter Property="Foreground" Value="#10121F"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="Background" Value="#3A4266"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#9BA8C7"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="#191D30"
                                CornerRadius="8,8,0,0"
                                Padding="14,8"
                                Margin="0,0,4,0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#00D5F2"/>
                                <Setter Property="Foreground" Value="#10121F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="470"/>
        </Grid.ColumnDefinitions>

        <!-- =================================================== -->
        <!-- LEFT SIDE: header + chat + message box (Part 1 / 2) -->
        <!-- =================================================== -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ASCII ART HEADER -->
            <StackPanel Grid.Row="0"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,12">

                <TextBlock TextWrapping="NoWrap"
                           FontFamily="Consolas"
                           FontSize="11"
                           Foreground="#00E5FF"
                           TextAlignment="Center">
                    <Run Text="  ____      _               ____ _           _   ____        _   "/>
                    <LineBreak/>
                    <Run Text=" / ___|   _| |__   ___ _ __/ ___| |__   __ _| |_| __ )  ___ | |_"/>
                    <LineBreak/>
                    <Run Text="| |  | | | | '_ \ / _ \ '__| |   | '_ \ / _` | __|  _ \ / _ \| __|"/>
                    <LineBreak/>
                    <Run Text="| |__| |_| | |_) |  __/ |  | |___| | | | (_| | |_| |_) | (_) | |_"/>
                    <LineBreak/>
                    <Run Text=" \____\__, |_.__/ \___|_|   \____|_| |_|\__,_|\__|____/ \___/ \__|"/>
                    <LineBreak/>
                    <Run Text="      |___/"/>
                </TextBlock>

                <TextBlock Text="CYBERSECURITY CHATBOT"
                           FontSize="23"
                           FontWeight="Bold"
                           Foreground="#FFFFFF"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,4"/>

                <TextBlock Text="Stay alert. Stay secure."
                           Foreground="#9BA8C7"
                           HorizontalAlignment="Center"
                           FontSize="13"/>
            </StackPanel>

            <!-- CHAT HISTORY -->
            <Border Grid.Row="1"
                    Background="#191D30"
                    CornerRadius="12"
                    Padding="12"
                    Margin="0,0,0,12">

                <ScrollViewer x:Name="ChatScroll"
                              VerticalScrollBarVisibility="Auto">

                    <StackPanel x:Name="ChatMessages"/>
                </ScrollViewer>
            </Border>

            <!-- MESSAGE INPUT -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="MessageInput"
                         Grid.Column="0"
                         Height="45"
                         FontSize="14"
                         Padding="10"
                         VerticalContentAlignment="Center"
                         Background="#252A40"
                         Foreground="White"
                         BorderBrush="#00E5FF"
                         CaretBrush="White"
                         ToolTip="Type a message"
                         KeyDown="MessageInput_KeyDown"/>

                <Button x:Name="SendButton"
                        Grid.Column="1"
                        Content="Send Message"
                        Margin="10,0,0,0"
                        Height="45"
                        FontWeight="Bold"
                        Background="#00D5F2"
                        Foreground="#10121F"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="SendButton_Click"/>
            </Grid>
        </Grid>

        <!-- =================================================== -->
        <!-- RIGHT SIDE: Part 3 features in tabs                  -->
        <!-- =================================================== -->
        <TabControl x:Name="MainTabs"
                    Grid.Column="1"
                    Margin="15,0,0,0">

            <!-- ============ TAB 1: TASK ASSISTANT (MySQL) ============ -->
            <TabItem Header="📋 Tasks">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Add-task form -->
                    <Border Grid.Row="0"
                            Background="#191D30"
                            CornerRadius="10"
                            Padding="12">
                        <StackPanel>
                            <TextBlock Text="Add a new task"
                                       Foreground="White"
                                       FontSize="15"
                                       FontWeight="Bold"/>

                            <TextBlock x:Name="DbStatusText"
                                       FontSize="11"
                                       Margin="0,2,0,0"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="Title" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TitleBox"
                                     Style="{StaticResource DarkBox}"
                                     MaxLength="150"
                                     ToolTip="e.g. Enable two-factor authentication"/>

                            <TextBlock Text="Description" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="DescBox"
                                     Style="{StaticResource DarkBox}"
                                     MaxLength="500"
                                     Height="55"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     ToolTip="What needs to be done and why"/>

                            <TextBlock Text="Reminder (optional)" Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox x:Name="ReminderCombo"
                                          Grid.Column="0"
                                          SelectionChanged="ReminderCombo_SelectionChanged"
                                          ToolTip="Choose a timeframe, or pick a custom date">
                                    <ComboBoxItem Content="No reminder"/>
                                    <ComboBoxItem Content="Tomorrow"/>
                                    <ComboBoxItem Content="In 3 days"/>
                                    <ComboBoxItem Content="In 1 week"/>
                                    <ComboBoxItem Content="In 2 weeks"/>
                                    <ComboBoxItem Content="Pick a date..."/>
                                </ComboBox>

                                <DatePicker x:Name="ReminderDate"
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            IsEnabled="False"
                                            ToolTip="Used when 'Pick a date...' is selected"/>
                            </Grid>

                            <Button x:Name="AddTaskButton"
                                    Content="Add Task"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,12,0,0"
                                    Click="AddTaskButton_Click"/>

                            <TextBlock x:Name="FormMessage"
                                       Foreground="#FFB86B"
                                       FontSize="12"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- List heading -->
                    <Grid Grid.Row="1" Margin="2,14,2,6">
                        <TextBlock Text="Your tasks"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="TaskCountText"
                                   Foreground="#9BA8C7"
                                   FontSize="12"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Task cards -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="NoTasksText"
                                       Text="No tasks yet. Add one above, or type 'Add task - Review privacy settings' in the chat."
                                       Foreground="#9BA8C7"
                                       TextWrapping="Wrap"
                                       Margin="4,6,4,0"/>

                            <ItemsControl x:Name="TaskList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#252A40"
                                                CornerRadius="8"
                                                Padding="10"
                                                Margin="0,0,0,8">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="{Binding Title}"
                                                               Foreground="White"
                                                               FontWeight="Bold"
                                                               FontSize="14"
                                                               TextWrapping="Wrap"
                                                               Margin="0,0,40,0"/>
                                                    <TextBlock Text="{Binding IdLabel}"
                                                               Foreground="#9BA8C7"
                                                               HorizontalAlignment="Right"/>
                                                </Grid>

                                                <TextBlock Text="{Binding Description}"
                                                           Foreground="#C9D1E8"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0"/>

                                                <TextBlock Text="{Binding ReminderText}"
                                                           Foreground="#FFD166"
                                                           FontSize="12"
                                                           Margin="0,6,0,0"/>

                                                <TextBlock Text="{Binding StatusText}"
                                                           Foreground="#7CFC9A"
                                                           FontSize="12"
                                                           Margin="0,2,0,0"/>

                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,8,0,0">
                                                    <Button Content="✔ Mark completed"
                                                            Style="{StaticResource SmallButton}"
                                                            Tag="{Binding Id}"
                                                            IsEnabled="{Binding CanComplete}"
                                                            Click="CompleteTask_Click"/>
                                                    <Button Content="🗑 Delete"
                                                            Style="{StaticResource SmallButton}"
                                                            Margin="8,0,0,0"
                                                            Tag="{Binding Id}"
                                                            Click="DeleteTask_Click"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ============ TAB 2: CYBERSECURITY QUIZ ============ -->
            <TabItem Header="🎮 Quiz">
                <Border Background="#191D30"
                        CornerRadius="10"
                        Padding="16"
                        Margin="0,10,0,0">
                    <Grid>
                        <!-- Start screen -->
                        <StackPanel x:Name="QuizStartPanel" VerticalAlignment="Center">
                            <TextBlock Text="Cybersecurity Quiz"
                                       Foreground="White"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="12 questions on phishing, passwords, safe browsing and social engineering. Multiple choice and true/false. You get instant feedback after every answer."
                                       Foreground="#C9D1E8"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="10,12,10,18"/>
                            <Button Content="Start Quiz"
                                    Style="{StaticResource ActionButton}"
                                    Width="160"
                                    Click="StartQuizButton_Click"/>
                        </StackPanel>

                        <!-- Question screen -->
                        <ScrollViewer x:Name="QuizQuestionPanel"
                                      Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid>
                                    <TextBlock x:Name="QuizProgressText"
                                               Foreground="#9BA8C7"
                                               FontWeight="Bold"/>
                                    <TextBlock x:Name="QuizScoreText"
                                               Foreground="#7CFC9A"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Right"/>
                                </Grid>

                                <TextBlock x:Name="QuizTypeText"
                                           Foreground="#00D5F2"
                                           FontSize="11"
                                           Margin="0,8,0,0"/>

                                <TextBlock x:Name="QuizQuestionText"
                                           Foreground="White"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,16"/>

                                <StackPanel x:Name="OptionsPanel"/>

                                <TextBlock x:Name="QuizFeedbackText"
                                           FontSize="14"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,12"/>

                                <Button x:Name="SubmitAnswerButton"
                                        Content="Submit Answer"
                                        Style="{StaticResource ActionButton}"
                                        Click="SubmitAnswer_Click"/>

                                <Button x:Name="NextQuestionButton"
                                        Content="Next Question"
                                        Style="{StaticResource ActionButton}"
                                        Visibility="Collapsed"
                                        Click="NextQuestion_Click"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Result screen -->
                        <StackPanel x:Name="QuizResultPanel"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Quiz complete!"
                                       Foreground="White"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="QuizFinalScoreText"
                                       Foreground="#7CFC9A"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,10,0,6"/>
                            <TextBlock x:Name="QuizFinalMessageText"
                                       Foreground="#C9D1E8"
                                       FontSize="15"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="10,0,10,18"/>
                            <Button Content="Play Again"
                                    Style="{StaticResource ActionButton}"
                                    Width="160"
                                    Click="StartQuizButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ============ TAB 3: ACTIVITY LOG ============ -->
            <TabItem Header="📜 Activity Log">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="2,0,2,8">
                        <TextBlock Text="Everything the chatbot has done for you. In the chat you can also type 'Show activity log' or 'What have you done for me?'"
                                   Foreground="#9BA8C7"
                                   TextWrapping="Wrap"/>
                        <CheckBox x:Name="ShowFullLogCheck"
                                  Content="Show full history (otherwise only the last 10 actions)"
                                  Foreground="White"
                                  Margin="0,8,0,0"
                                  Checked="ShowFullLog_Changed"
                                  Unchecked="ShowFullLog_Changed"/>
                        <TextBlock x:Name="LogCountText"
                                   Foreground="#9BA8C7"
                                   FontSize="12"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1"
                            Background="#191D30"
                            CornerRadius="10"
                            Padding="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="NoLogText"
                                           Text="Nothing here yet. Add a task or start the quiz!"
                                           Foreground="#9BA8C7"/>
                                <ItemsControl x:Name="ActivityList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       Foreground="White"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,8"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
